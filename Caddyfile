{
    frankenphp
    order php_server before file_server
}

:80 {
    root * /app/public

    # Sert images depuis le volume (sans PHP)
    handle_path /images/* {
        root * /app/storage/images
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Symfony
    php_server
}
